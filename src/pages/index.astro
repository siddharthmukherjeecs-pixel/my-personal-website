---
import ProBase from "../layouts/ProBase.astro";
import Topbar from "../components/pro/Topbar.astro";
import Hero from "../components/pro/Hero.astro";
import About from "../components/pro/About.astro";
import Awards from "../components/pro/Awards.astro";
import Principles from "../components/pro/Principles.astro";
import Ticker from "../components/pro/Ticker.astro";
import Services from "../components/pro/Services.astro";
import Gallery from "../components/pro/Gallery.astro";
import FAQ from "../components/pro/FAQ.astro";
import Contact from "../components/pro/Contact.astro";
import Footer from "../components/pro/Footer.astro";
---
<ProBase>
  <Topbar path="/" />
  <main>
    <Hero />
    <About />
    <Awards />
    <Principles />
    <Ticker />
    <Services />
    <Gallery />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</ProBase>
