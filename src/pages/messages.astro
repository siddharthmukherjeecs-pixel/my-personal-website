---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import Guestbook from "@components/organisms/Guestbook.svelte";
import { profileConfig } from "@/config/profileConfig";

const pageTitle = "Messages";
const pageDescription = "Leave a little feeling here. Pick a color you like and leave a thought from this moment.";
---

<MainGridLayout title={pageTitle} description={pageDescription} page="messages">
	<div class="w-full">
		<Guestbook
			client:load
			authorName={profileConfig.name}
			authorAvatar="/images/banner/kanade-hero.webp"
		/>
	</div>
</MainGridLayout>
