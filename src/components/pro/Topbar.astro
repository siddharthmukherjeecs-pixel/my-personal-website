---
import { proSite } from "@/lib/proSite";
import Icon from "./Icon.astro";

interface Props {
  path?: string;
}
const { path = "/" } = Astro.props;
const isCurrent = (href: string) => href === path;
---
<header class="topbar" data-topbar>
  <div class="topbar-bar container">
    <div class="topbar-logo">
      <a href="/" class="body" style="color: var(--white); font-weight: 600">{proSite.name}</a>
      <p class="body muted">{proSite.role}</p>
    </div>
    <nav class="topbar-links" aria-label="Primary">
      {proSite.nav.map((l) => <a class:list={["body-sb", { "is-current": isCurrent(l.href) }]} href={l.href}>{l.label}</a>)}
      <button type="button" class="recruiter-pill" data-open-dossier title="Executive summary for interviewers and engineering leads">
        <span>💼 For Interviewers</span>
      </button>
      <a href="/garden/" class="mode-toggle-pill" title="Explore Casual Garden (Blog, Music, Anime)">
        <span>🎮 Casual Garden</span>
      </a>
    </nav>
    <div style="display: flex; align-items: center; gap: 12px">
      <button type="button" class="topbar-menu" aria-label="Open menu" aria-expanded="false" data-menu-btn>
        <span class="topbar-icon" data-icon-open><Icon name="menu" size={24} stroke={1} /></span>
        <span class="topbar-icon" data-icon-close style="opacity: 0"><Icon name="x" size={24} stroke={1} /></span>
      </button>
    </div>
  </div>
  <nav class="topbar-mobile" aria-label="Mobile" aria-hidden="true" data-mobile-nav>
    <button type="button" class="recruiter-pill" data-open-dossier style="margin-bottom: 8px; width: 100%; justify-content: center; padding: 12px;">
      <span>💼 For Interviewers &amp; Leads</span>
    </button>
    <a href="/garden/" class="mode-toggle-pill" style="margin-bottom: 12px; width: 100%; justify-content: center; padding: 12px; font-size: 14px;">
      <span>🎮 Casual Garden</span>
    </a>
    <div style="height: 1px; background: rgba(255,255,255,0.15); margin-bottom: 12px;"></div>
    {proSite.nav.map((l) => <a class:list={["h3", { "is-current": isCurrent(l.href) }]} href={l.href} tabindex="-1">{l.label}</a>)}
  </nav>
</header>
