---
import { proSite } from "@/lib/proSite";
import ScrollWords from "./ScrollWords.astro";
import ScrollFade from "./ScrollFade.astro";
const { about } = proSite;
---
<section id="about" class="about">
  <div class="about-stage">
    <div class="about-parallax" data-parallax>
      <div class="about-media">
        <img src={about.portrait || "/assets/siddharth-portrait.webp"} alt={`${proSite.name}, ${proSite.role.toLowerCase()}`} loading="lazy" style="object-position: center 30%;" />
      </div>
    </div>
    <div class="about-scrim" aria-hidden="true"></div>
    <div class="about-content">
      <div class="about-statement-row container">
        <div class="about-statement">
          <ScrollWords as="h2" class="h2 balance" style="text-align: end" text={about.statement} />
        </div>
      </div>
      <div class="about-bio-row container">
        <div class="about-bio-col">
          <p class="body muted">ABOUT</p>
          <ScrollFade>
            <div class="about-paragraphs">
              <p class="body balance">{about.bio}</p>
              <p class="body balance">
                {about.contactLead} <a href={`mailto:${proSite.email}`} style="color: var(--white)">{proSite.email}</a> {about.contactTail}
              </p>
            </div>
          </ScrollFade>
          <p class="body muted">{proSite.name.toUpperCase()} — {proSite.year}</p>
        </div>
      </div>
    </div>
  </div>
</section>
