---
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrl } from "@/utils/url-utils";
import Icon from "./Icon.astro";
import ScrollWords from "./ScrollWords.astro";

const allPosts = await getSortedPosts();
// Show up to 4 most recent published posts
const featuredPosts = allPosts.slice(0, 4);

function formatDate(d: Date | string | undefined) {
  if (!d) return "";
  const date = typeof d === "string" ? new Date(d) : d;
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric"
  }).format(date);
}
---

{featuredPosts.length > 0 && (
  <section id="writing" class="pro-writing container">
    <div class="writing-header">
      <div class="writing-top">
        <p class="body-sb" style="color: var(--grey); text-transform: uppercase; letter-spacing: 0.08em; font-size: 13px;">
          TECHNICAL WRITING &amp; LOGS
        </p>
        <div class="writing-actions-top">
          <a href="/garden/" class="garden-pill-link" title="Read all articles in the Casual Garden feed">
            <span>Explore Casual Garden ↗</span>
          </a>
        </div>
      </div>
      <ScrollWords as="h2" class="h2 balance" text="Engineering Notes & Architecture Logs" />
      <p class="body balance writing-sub">
        Documenting hands-on experiments, benchmarks, and architectural takeaways in AI/ML, local LLM orchestration, and systems programming.
      </p>
    </div>

    <div class="writing-grid">
      {featuredPosts.map((post) => {
        const postUrl = getPostUrl(post);
        const category = post.data.category || "Engineering";
        const tags = (post.data.tags || []).slice(0, 3);
        const dateStr = formatDate(post.data.published);

        return (
          <article class="writing-card">
            <a href={postUrl} class="card-main-link" aria-label={`Read ${post.data.title}`}>
              <div class="card-meta">
                <span class="card-category">{category}</span>
                {dateStr && <span class="card-date">{dateStr}</span>}
              </div>

              <h3 class="h4 card-title">{post.data.title}</h3>

              {post.data.description && (
                <p class="body card-desc">{post.data.description}</p>
              )}

              <div class="card-footer">
                <div class="card-tags">
                  {tags.map((tag: string) => (
                    <span class="card-tag">#{tag}</span>
                  ))}
                </div>
                <span class="card-arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={18} stroke={2} />
                </span>
              </div>
            </a>
          </article>
        );
      })}
    </div>

    <div class="writing-bottom-bar">
      <div class="bottom-info">
        <span class="live-dot"></span>
        <p class="body" style="font-size: 14px; color: var(--white-60)">
          Dual-surfaced: All posts are written once in <a href="/keystatic" class="pro-inline-link">Keystatic Studio</a> and published to both the Pro Showcase and the Casual Garden.
        </p>
      </div>
      <div class="bottom-links">
        <a href="/garden/" class="btn-subtle">
          <span>All Garden Posts ↗</span>
        </a>
        <a href="/keystatic" class="btn-subtle">
          <span>Studio CMS ↗</span>
        </a>
      </div>
    </div>
  </section>
)}

<style>
.pro-writing {
  padding-top: clamp(60px, 8vw, 120px);
  padding-bottom: clamp(60px, 8vw, 120px);
  padding-left: 20px;
  padding-right: 20px;
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.writing-header {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.writing-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}
.garden-pill-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--white);
  font-size: 13px;
  font-weight: 500;
  transition: all 0.25s var(--ease-out);
}
.garden-pill-link:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-1px);
}
.writing-sub {
  color: var(--white-60);
  max-width: 680px;
  font-size: clamp(15px, 0.35vw + 0.85rem, 17px);
}

.writing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  gap: 20px;
}
@media (max-width: 640px) {
  .writing-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
}

.writing-card {
  position: relative;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 16px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  transition: all 0.35s var(--ease-out);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.writing-card:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(56, 189, 248, 0.35);
  box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.1);
  transform: translateY(-3px);
}

.card-main-link {
  display: flex;
  flex-direction: column;
  gap: 16px;
  height: 100%;
}
.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
}
.card-category {
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.25);
  padding: 2px 8px;
  border-radius: 6px;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.card-date {
  color: var(--white-40);
}
.card-title {
  color: var(--white);
  font-weight: 600;
  line-height: 1.35;
  transition: color 0.2s ease;
}
.writing-card:hover .card-title {
  color: #38bdf8;
}
.card-desc {
  color: var(--grey);
  font-size: 14px;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex-grow: 1;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  margin-top: auto;
}
.card-tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.card-tag {
  font-size: 11.5px;
  color: var(--white-40);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
}
.card-arrow {
  color: var(--white-40);
  transition: all 0.25s var(--ease-out);
}
.writing-card:hover .card-arrow {
  color: #38bdf8;
  transform: translate(2px, -2px);
}

.writing-bottom-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
}
.bottom-info {
  display: flex;
  align-items: center;
  gap: 10px;
}
.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 8px #22c55e;
  animation: pulse-dot 2s infinite ease-in-out;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}
.pro-inline-link {
  color: #38bdf8;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.bottom-links {
  display: flex;
  gap: 12px;
}
.btn-subtle {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  color: var(--white-60);
  padding: 6px 12px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.04);
  transition: all 0.2s ease;
}
.btn-subtle:hover {
  color: var(--white);
  background: rgba(255, 255, 255, 0.08);
}
@media (max-width: 640px) {
  .writing-bottom-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
  }
  .bottom-links {
    width: 100%;
    flex-wrap: wrap;
  }
  .writing-card {
    padding: 22px 18px;
  }
}
</style>
