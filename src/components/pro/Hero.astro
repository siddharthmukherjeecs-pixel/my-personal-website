---
import { getProProjects, proSite } from "@/lib/proSite";
import Icon from "./Icon.astro";

const projects = getProProjects();
const slides = projects.map((p) => ({
  src: p.heroImage,
  alt: p.heroAlt,
  category: p.category,
  title: p.title,
  link: `#focus`,
}));
const n = slides.length;

function getTitleWords(title: string) {
  let letterIndex = 0;
  return title.split(" ").map((word) => {
    const letters = word.split("").map((ch) => {
      const delay = (0.12 + letterIndex * 0.025).toFixed(2);
      letterIndex++;
      return { ch, delay };
    });
    letterIndex++; // count space
    return letters;
  });
}
---
<section id="hero" class="hero container">
  <div class="hero-stage">
    <div style="width: 100%; position: relative; display: flex; flex-direction: column; align-items: center">
      <div class="pc-root" style={`--n: ${n}`} data-carousel data-slides={JSON.stringify(slides.map((s) => s.src))}>
        <div class="pc-sticky">
          <canvas class="pc-canvas"></canvas>
          <div class="pc-overlays">
            {slides.map((s, i) => {
              const words = getTitleWords(s.title);
              return (
                <div class={"pc-center pc-overlay" + (i === 0 ? " pc-ref-active" : "")} style={`--i: ${i}`} data-overlay>
                  <a class="pc-ref-link" href={s.link} aria-label={`Open ${s.title}`}>
                    <span class="pc-ref-ltr pc-cat">{s.category}</span>
                    <h2 class="pc-title">
                      {words.map((word) => (
                        <span class="pc-word">
                          {word.map((l) => (
                            <span class="pc-ref-ltr" style={`transition-delay: ${l.delay}s`}>{l.ch}</span>
                          ))}
                        </span>
                      ))}
                    </h2>
                    <span class="pc-ref-btn" aria-hidden="true"><Icon name="carousel-arrow" size={22} /></span>
                  </a>
                </div>
              );
            })}
          </div>
          {n > 1 && (
            <div class="pc-bar" data-bar>
              {slides.map((s, i) => (
                <button type="button" class="pc-nav-btn" aria-label={`Go to ${s.title}`} aria-current={i === 0 ? "true" : undefined} data-goto={i}>
                  <span class={"pc-nav-bar" + (i === 0 ? " pc-nav-active" : "")}></span>
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="pc-fallback">
          {slides.map((s) => (
            <section class="pc-fb-slide pc-ref-active">
              <div class="pc-fb-media"><img src={s.src} alt={s.alt} loading="lazy" /></div>
              <div class="pc-center">
                <a class="pc-ref-link" href={s.link} aria-label={`Open ${s.title}`}>
                  <span class="pc-ref-ltr pc-cat">{s.category}</span>
                  <h2 class="pc-title">
                    {s.title.split(" ").map((w) => (
                      <span class="pc-word">
                        {w.split("").map((ch) => <span class="pc-ref-ltr">{ch}</span>)}
                      </span>
                    ))}
                  </h2>
                  <span class="pc-ref-btn" aria-hidden="true"><Icon name="carousel-arrow" size={22} /></span>
                </a>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="hero-bottom">
    <h1 class="body balance hero-heading">{proSite.tagline}</h1>
  </div>
</section>
